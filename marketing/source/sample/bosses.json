  // Boss difficulty preset
  // Allowed: EASY, NORMAL, HARD
  // Default: "NORMAL"
  "difficulty": "NORMAL",
  // Dimensions where bosses never spawn
  "disabledDimensions": ["minecraft:the_end"]
}
